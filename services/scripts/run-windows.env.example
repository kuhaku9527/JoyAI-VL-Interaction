# JoyAI-VL-Interaction :: run-windows.env (example)
# Loaded by services\scripts\run-windows.ps1.
# Copy this file to run-windows.env and edit values for your machine.

# ---------------------------------------------------------------------------
# Root locations
# ---------------------------------------------------------------------------
JOYAI_BIN_ROOT=D:\AI\bin
JOYAI_MODELS_ROOT=D:\AI\models
JOYAI_TOOLS_ROOT=D:\AI\tools
JOYAI_VENV_PY=D:\AI\workspace\JoyAI-VL-Interaction-main\services\.venv\Scripts\python.exe

# Override any individual binary explicitly. Leave blank to use the defaults
# relative to JOYAI_BIN_ROOT.
# LLAMA_SERVER=D:\AI\bin\llama.cpp\llama-server.exe
# WHISPER_SERVER=D:\AI\bin\whisper.cpp\whisper-server.exe
# HERMES_EXE=%LOCALAPPDATA%\hermes\bin\hermes.cmd

# ---------------------------------------------------------------------------
# Ports (match the original Linux deployment)
# ---------------------------------------------------------------------------
# MAIN_MODEL_PORT=7060          # llama-server main (JoyAI-VL-Interaction)
# SUMMARY_PORT=8065             # llama-server summary (Qwen2.5-VL-3B)
# ADAPTER_PORT=8070             # webinfer live adapter
# CODEX_API_PORT=8079           # background-agent shim
# WEBUI_PORT=8099               # webui (https)
# HERMES_GATEWAY_PORT=8642      # hermes-agent gateway
# VOICE_CLONE_PORT=8985         # voice-clone API
# TTS_MODEL_PORT=8991           # CosyVoice3 FastAPI
# TTS_ADAPTER_PORT=8992         # tts-adapter
# ASR_MODEL_PORT=8993           # whisper.cpp server
# ASR_ADAPTER_PORT=8994         # asr-adapter

# ---------------------------------------------------------------------------
# Main model (llama-server)
# ---------------------------------------------------------------------------
# MAIN_CONTEXT=32768
# MAIN_EXTRA_ARGS=--slots --batch-size 512

# Summary model (llama-server)
# SUMMARY_CONTEXT=8192
# SUMMARY_EXTRA_ARGS=

# whisper.cpp
# WHISPER_EXTRA_ARGS=

# CosyVoice (FastAPI server)
# COSYVOICE_DIR=D:\AI\tools\CosyVoice
# COSYVOICE_MODEL_DIR=D:\AI\models\tts\CosyVoice3-0.5B
# COSYVOICE_PY=%USERPROFILE%\miniconda3\envs\cosyvoice\python.exe
# COSYVOICE_EXTRA_ARGS=

# voice-clone API
# VOICES_DIR=D:\AI\workspace\JoyAI-VL-Interaction-main\services\voice-clone\voices
# VOICE_CLONE_EXTRA_ARGS=

# Hermes-agent gateway
# HERMES_API_KEY=put-the-key-from-setup-hermes-output-here
# The matching API key must also be in background-agent.env (HERMES_API_KEY=...).

# background-agent (hermes shim)
# CODEX_API_MAX_SUBAGENTS=6
# BG_AGENT_EXTRA_ARGS=

# webinfer
# FRAME_SAVE_DIR=C:\AI\frames
# SYSTEM_PROMPT=D:\AI\workspace\JoyAI-VL-Interaction-main\prompts\bt-7274.txt
# CHARACTER_PROMPT_PATH=D:\AI\workspace\JoyAI-VL-Interaction-main\prompts
# WEBINFER_EXTRA_ARGS=

# tts-adapter
# TTS_DEFAULT_VOICE=中文女
# TTS_ADAPTER_EXTRA_ARGS=

# asr-adapter
# ASR_ADAPTER_EXTRA_ARGS=

# webui
# WEBUI_EXTRA_ARGS=

# ---------------------------------------------------------------------------
# Cross-cutting behaviour
# ---------------------------------------------------------------------------
# LOG_LEVEL=INFO                 # DEBUG / INFO / WARNING / ERROR
# FORCE_SILENCE_BEFORE_QUERY=false   # auto-set in 'gaming' mode; do not edit otherwise

# ---------------------------------------------------------------------------
# GPU memory budget (informational; not all args are passed to llama-server)
# Each llama-server defaults: -ngl 999  (offload every layer)
# If you need to share the 5060 Ti with CosyVoice + whisper.cpp, lower this.
# ---------------------------------------------------------------------------
# MAIN_GPU_LAYERS=999
# SUMMARY_GPU_LAYERS=999

# ---------------------------------------------------------------------------
# MiniMax cloud TTS / voice clone
# ---------------------------------------------------------------------------
# Keep MINIMAX_API_KEY in the User/Process environment; do not commit it here.
# PowerShell: [Environment]::SetEnvironmentVariable('MINIMAX_API_KEY','sk-cp-...','User')
# MINIMAX_GROUP_ID=replace-me
# TTS_PROVIDER=minimax
MINIMAX_BASE_URL=https://api.minimaxi.com
MINIMAX_DEFAULT_MODEL=speech-2.8-hd
MINIMAX_LANGUAGE_BOOST=Chinese
# TTS_DEFAULT_VOICE_ID=minimax_man_33333
